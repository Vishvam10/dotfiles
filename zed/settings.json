{
    "session": {
        "trust_all_worktrees": true,
    },
    "feature_flags": {
        "tabular-data-preview": "on",
        "notebooks": "on",
    },
    // -----------------------------------------------------------------------
    // ASSISTANT, TELEMETRY, ETC
    // -----------------------------------------------------------------------

    "buffer_font_weight": 400.0,
    "buffer_font_family": ".ZedMono",
    "inline_code_actions": false,
    "relative_line_numbers": "disabled",
    "gutter": {
        "min_line_number_digits": 4,
        "folds": true,
        "runnables": true,
        "line_numbers": true,
    },
    "drag_and_drop_selection": {
        "enabled": true,
    },
    "soft_wrap": "editor_width",
    "buffer_line_height": "comfortable",
    "disable_ai": true,
    "use_system_window_tabs": false,
    "bottom_dock_layout": "contained",
    "title_bar": {
        "button_layout": "platform_default",
        "show_branch_status_icon": false,
    },
    "status_bar": {
        "show_active_file": false,
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "proxy": "",
    "show_edit_predictions": false,
    "diff_view_style": "split",
    "git_panel": {
        "dock": "left",
        "tree_view": true,
    },
    "theme": "One Dark Pro Vivid",
    "edit_predictions": {
        "allow_data_collection": "no",
        "ollama": {
            "model": "llama3.2:latest",
            "api_url": "http://localhost:11434",
        },
        "provider": "none",
    },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "telemetry": {
        "metrics": false,
        "diagnostics": false,
    },
    "agent": {
        "default_profile": "plan",
        "profiles": {
            "plan": {
                "default_model": {
                    "provider": "ollama",
                    "model": "llama3.2:latest",
                    "enable_thinking": false,
                },
                "name": "Plan",
                "tools": {
                    "delete_path": false,
                    "copy_path": true,
                    "create_directory": true,
                    "diagnostics": true,
                    "edit_file": true,
                    "fetch": true,
                    "find_path": true,
                    "grep": true,
                    "list_directory": true,
                    "move_path": true,
                    "now": true,
                    "open": true,
                    "read_file": true,
                    "restore_file_from_disk": false,
                    "update_plan": true,
                    "terminal": false,
                    "spawn_agent": false,
                    "save_file": true,
                },
                "enable_all_context_servers": false,
                "context_servers": {
                    "mcp-server-context7": {
                        "tools": {
                            "resolve-library-id": true,
                            "query-docs": true,
                        },
                    },
                    "mcp-server-sequential-thinking": {
                        "tools": {
                            "sequentialthinking": true,
                        },
                    },
                },
            },
        },
        "default_model": {
            "provider": "ollama",
            "model": "llama3.2:latest",
            "enable_thinking": false,
        },
        "single_file_review": false,
        "flexible": true,
        "button": true,
        "dock": "right",
        "sidebar_side": "right",
        "show_turn_stats": false,
        "use_modifier_to_send": true,
        "expand_terminal_card": true,
        "enabled": false,
    },

    // This shit is cool though. No python scripts needed
    "journal": {
        "path": "~/Desktop/Notes",
        "hour_format": "hour12",
    },

    // -----------------------------------------------------------------------
    // LSP (AND ITS CAPABILITIES), LINT, FORMAT
    // -----------------------------------------------------------------------

    "languages": {
        "C++": {
            "inlay_hints": {
                "enabled": false,
            },
        },
        "Python": {
            "code_actions_on_format": {
                "source.organizeImports.ruff": true,
                "source.fixAll.ruff": true,
            },
            "language_servers": ["pyright", "ruff"],
            "format_on_save": "on",
            "formatter": [],
        },
        "Go": {
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "gopls",
                },
            },
        },
    },

    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
        "show_background": false,
        "edit_debounce_ms": 700,
        "scroll_debounce_ms": 50,
    },

    "auto_signature_help": true,

    "use_autoclose": true,

    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },

    // -----------------------------------------------------------------------
    // EDITOR THEMING AND APPEARANCE
    // -----------------------------------------------------------------------

    "ui_font_size": 16.0,
    "buffer_font_size": 16.0,
    // "buffer_line_height": {
    //     "custom": 1.6
    // },
    "terminal": {
        // Converts mouse scroll events into up / down key presses when in the
        // alternate screen (useful for commands like "less", "cat", etc)
        "alternate_scroll": "off",
        "line_height": "standard",
        "toolbar": {
            "breadcrumbs": false,
        },
        "dock": "right",
        "working_directory": "current_project_directory",
        "button": false,
    },

    // Refer this, it's quite handy : https://github.com/zed-industries/zed/blob/main/assets/themes/one/one.json
    "experimental.theme_overrides": {},
    "outline_panel": {
        "dock": "left",
    },
    "project_panel": {
        "button": true,
        "default_width": 240,
        "dock": "left",
        "file_icons": true,
        "folder_icons": false,
        "git_status": true,
        "indent_size": 10,
        "auto_reveal_entries": true,
        "auto_fold_dirs": true,
        "scrollbar": {
            "show": null,
        },
    },
    "scrollbar": {
        "axes": {
            "horizontal": true,
        },
        "diagnostics": "all",
        "git_diff": true,
    },
    "tabs": {
        // Show git status colors in the editor tabs.
        "git_status": true,
    },
    "tab_bar": {
        "show": true,
    },
    "active_pane_modifiers": {
        "border_size": 0,
        "inactive_opacity": 1.0,
    },
    "tab_size": 4,
    "toolbar": {
        "agent_review": true,
        "breadcrumbs": true,
        "quick_actions": false,
    },
    "preferred_line_length": 80,
    "show_wrap_guides": true,

    // Learn Vim at some point
    "vim_mode": false,
}
